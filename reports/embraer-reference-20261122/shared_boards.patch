+class _BreezyHeadings(HTMLParser):
+    _void = {'area', 'base', 'br', 'col', 'embed', 'hr', 'img', 'input',
+             'link', 'meta', 'param', 'source', 'track', 'wbr'}
+
+    def __init__(self):
+        super().__init__()
+        self.stack = []
+        self.headings = []
+        self.heading = None
+
+    def handle_starttag(self, tag, attrs):
+        if tag in self._void:
+            return
+        classes = dict(attrs).get('class', '').split()
+        if tag == 'h1':
+            parent = self.stack[-1] if self.stack else None
+            self.heading = (parent, [])
+        self.stack.append((tag, classes))
+
+    def handle_data(self, data):
+        if self.heading is not None:
+            self.heading[1].append(data)
+
+    def handle_endtag(self, tag):
+        if tag == 'h1' and self.heading is not None:
+            parent, parts = self.heading
+            scope = ''
+            if parent:
+                parent_tag, classes = parent
+                if parent_tag == 'a' and 'brand' in classes:
+                    scope = 'brand'
+                if parent_tag == 'div' and 'banner' in classes:
+                    scope = 'banner'
+            self.headings.append((scope, text(''.join(parts))))
+            self.heading = None
+        for index in range(len(self.stack) - 1, -1, -1):
+            if self.stack[index][0] == tag:
+                del self.stack[index:]
+                break
+
+
+def _embraer_detail_heading(body, title):
+    # Some public Embraer details put an employer h1 above the job's banner.
+    parser = _BreezyHeadings()
+    parser.feed(body)
+    parser.close()
+    if len(parser.headings) != 2:
+        return False
+    (brand_scope, brand), banner = parser.headings
+    return brand_scope == 'brand' and bool(brand) and brand != title and banner == ('banner', title)
+
