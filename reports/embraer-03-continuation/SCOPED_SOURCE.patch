+def _continuation_edit(store, task, receipts, final_diff, baseline):
+    """Prove that exactly the accepted Jetson edit produced the final parser."""
+    import re
+    from hashlib import sha256
+    from pathlib import Path
+
+    from coordinator_inference import digest, valid_inference_binding, valid_inference_usage
+
+    calls = store.inference_receipts(task['id'])
+    edits = [item for item in receipts if item.get('name') in ('code_edit', 'code_create')]
+    if (len(calls) != 1 or len(edits) != 1 or final_diff['paths'] != [PARSER]
+            or task['edit_scope']['paths'] != [PARSER]
+            or (task['sessions'], task['calls']) != (8, 16) or not 118059 < task['tokens'] <= 120000):
+        return None
+    call, edit = calls[0], edits[0]
+    args = edit['arguments']
+    result = edit.get('result') or {}
+    usage = call.get('observed_usage')
+    response_hash = call.get('response_digest')
+    if (call.get('status') != 'COMPLETED' or call.get('task') != task['id'] or call.get('phase') != 'implement'
+            or call.get('identity_digest') != task['identity_binding_digest']
+            or call.get('integration_identity_digest') != task['integration_identity_digest']
+            or call.get('pre_counters') != {'sessions': 8, 'calls': 15, 'tokens': 118059}
+            or not isinstance(response_hash, str) or not re.fullmatch(r'[0-9a-f]{64}', response_hash)
+            or not valid_inference_binding(call.get('control_binding'), call.get('request_id'))
+            or not valid_inference_usage(usage) or usage['done_reason'] not in {'stop', 'tool_calls'}
+            or call['reserved_tokens'] > 1941
+            or 118059 + usage['prompt_eval_count'] + usage['eval_count'] != task['tokens']
+            or edit['task'] != task['id'] or edit['phase'] != 'implement' or edit['name'] != 'code_edit'
+            or not result.get('ok')
+            or not isinstance(args, dict) or set(args) != {'path', 'sha256', 'old', 'new'}
+            or not all(isinstance(value, str) for value in args.values())
+            or args['path'] != PARSER or not args['old'] or args['new'] == args['old']
+            or call.get('accepted_continuation_edit') != {
+                'path': PARSER, 'sha256': args['sha256'], 'arguments_sha256': digest(args)}):
+        return None
+    original = (Path(baseline) / PARSER).read_bytes()
+    if sha256(original).hexdigest() != args['sha256'] or final_diff['before'][PARSER] != args['sha256']:
+        return None
+    original = original.decode('utf-8')
+    if original.count(args['old']) != 1:
+        return None
+    repaired_hash = sha256(original.replace(args['old'], args['new'], 1).encode()).hexdigest()
+    if (result.get('result') != {'path': PARSER, 'updated': True, 'sha256': repaired_hash}
+            or repaired_hash != final_diff['after'][PARSER]):
+        return None
+    return {'request_id': call['request_id'], 'response_sha256': response_hash,
+            'edit_receipt_id': edit['id'], 'parser_sha256': repaired_hash}
