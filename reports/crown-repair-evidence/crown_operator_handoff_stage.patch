+"""Reviewed operator enrollment for one Crown SuccessFactors repair."""
+
+import json
+import os
+import re
+
+from embraer_operator_pilot import EmbraerOperatorEnrollment
+from job_search_helper.operator_partial_scope import CROWN, CROWN_REQUEST_ID
+
+
+ENV = 'WRAPPER_CROWN_OPERATOR_PILOT_ENROLLMENT'
+
+
+class CrownOperatorEnrollment(EmbraerOperatorEnrollment):
+    scope = CROWN
+    target = 'src/job_search_helper/successfactors.py'
+    profile_id = 'successfactors-crown-listing-range-v1'
+    test_paths = ('tests/test_crown_inventory_regression.py', 'tests/test_successfactors.py')
+    max_sessions = 4
+    repair_instructions = (
+        ' Crown’s first-party search omits the published range and shows only a subset. Use '
+        'the first-party job sitemap for exact Crown membership, including the observed TheGoods '
+        'and 17West job paths. Require stable scoped membership and complete canonical details. '
+        'Keep failures partial and do not relax other tenants’ completeness checks.'
+    )
+
+    def _read_settlement_source(self, repository, record):
+        from job_search_helper.operator_embraer_settlement import read_operator_partial_source
+
+        return read_operator_partial_source(repository, record, self.request_sha256, scope=CROWN)
+
+    @classmethod
+    def from_process_environment(cls, environ=None):
+        raw = (os.environ if environ is None else environ).get(ENV)
+        if raw is None:
+            return None
+        keys = {'request_id', 'source_revision', 'request_sha256', 'successfactors_sha256',
+                'ats_sha256', 'baseline_sha256'}
+        try:
+            pairs = json.loads(raw, object_pairs_hook=tuple) if isinstance(raw, str) and len(raw) <= 900 else None
+            value = dict(pairs) if isinstance(pairs, tuple) and len(pairs) == len(dict(pairs)) else {}
+            if (set(value) == keys and all(isinstance(item, str) for item in value.values())
+                    and CROWN_REQUEST_ID.fullmatch(value['request_id'])
+                    and all(re.fullmatch(r'[0-9a-f]{64}', value[key]) for key in keys - {'request_id'})):
+                return cls(value['request_id'], value['source_revision'], value['request_sha256'],
+                           value['successfactors_sha256'], value['ats_sha256'], value['baseline_sha256'])
+        except (TypeError, ValueError):
+            pass
+        raise ValueError('Invalid exact Crown operator pilot enrollment.')
