+"""Fixed one-edit profiles for the reviewed, receipt-owned continuations."""
+
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class Profile:
+    schema: str
+    parent: str
+    request: str
+    company: str
+    provider: str
+    category: str
+    baseline: str
+    target: str
+    parent_max_sessions: int
+    sessions: int
+    calls: int
+    tokens: int
+    token_cap: int
+
+    @property
+    def counters(self):
+        return {'sessions': self.sessions, 'calls': self.calls, 'tokens': self.tokens}
+
+    @property
+    def limits(self):
+        return {'sessions': self.sessions + 1, 'calls': self.calls + 1, 'tokens': self.token_cap}
+
+    @property
+    def reservation_counters(self):
+        return {**self.counters, 'sessions': self.sessions + 1}
+
+
+EMBRAER = Profile(
+    'embraer-03-continuation-v1', 'WRAP-250158dc79', 'operator-embraer-20261122-03',
+    'COMP-0634', 'Breezy HR', 'full_description_regression',
+    '065c73e80aa9a306b3691ca268a332c00b5c476b4ce4da46d9d224b2b81c5251',
+    'src/job_search_helper/shared_boards.py', 8, 7, 15, 118059, 120000,
+)
+CROWN = Profile(
+    'crown-01-continuation-v1', 'WRAP-640c600390', 'operator-crown-20261122-01',
+    'COMP-0588', 'SuccessFactors', 'pagination_regression',
+    '81d33e14f5bdfe508d6533c0f5aff546a6cf1cf02df3b56730cbf635d35c183d',
+    'src/job_search_helper/successfactors.py', 4, 4, 8, 51178, 56000,
+)
+
+
+def profile_for(authorization):
+    for profile in (EMBRAER, CROWN):
+        if (isinstance(authorization, dict) and authorization.get('schema') == profile.schema
+                and authorization.get('parent_task_id') == profile.parent
+                and authorization.get('baseline_sha256') == profile.baseline):
+            return profile
+    raise ValueError('Continuation does not match a reviewed exact parent and baseline.')
