+"""Bounded host-rendered context for one exact Crown adapter edit."""
+
+import json
+from hashlib import sha256
+from pathlib import Path
+
+
+TARGET = 'src/job_search_helper/successfactors.py'
+TEST = 'tests/test_crown_inventory_regression.py'
+ADAPTER_PIN = 'cd87c27f6b692b818226c85d92e5ca9c31d0bcbfb8f6ed94e0befdb81b66acf1'
+ANCHOR = '''def fetch_successfactors(url, company_id, company, transport=None):
+    host=SITES.get(url)'''
+STRATEGY = (
+    'Crown only: COMP-0588, Crown Equipment, CROWN_SOURCE. The current official search page has no '
+    'published range and shows only a subset of the jobs. Its exact same-host /sitemap.xml lists every '
+    'observed search ID as part of a larger cohort. Keep the current fallback behavior for other companies. '
+    'Implement one Crown-specific path using the sitemap, the installed adapter helpers and two stable '
+    'membership reads around details. No POST or other host. Do not change any tests or other files.'
+)
+
+
+def render(root, schema, assignment_manifest):
+    if schema.get('function', {}).get('name') != 'code_edit':
+        raise ValueError('Only a guarded code_edit may be offered.')
