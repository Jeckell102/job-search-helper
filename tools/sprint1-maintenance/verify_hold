#!/usr/bin/python3 -I
"""Verify the already-held, journal-bound Sprint 1 window for the installer."""
import json
from pathlib import Path
import subprocess
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
from controller import verify_request

try:
    print(json.dumps(verify_request(json.load(sys.stdin))))
except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
    sys.exit(f"Maintenance hold verification failed. {error}")
