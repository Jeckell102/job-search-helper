--- /dev/null
+++ b/src/job_search_helper/manual_company_start.py
@@ -0,0 +1,60 @@
+"""Route one ordinary Company event from a manual bare start."""
+
+from contextlib import ExitStack, closing
+import os
+
+from . import cli
+from .company_events import (BRIDGE_CONSUMER, CompanyEventBridge, _json_digest,
+                             has_pending_eligible_company_event, read_verified_queued_event)
+from .integration_release import assert_release_settled
+from .ordinary_company_event_command import (
+    _has_event_provenance, _open_readers, _request_file, execute_ordinary_event,
+)
+from .retained_work_runner import assert_normal_lifecycle_not_held
+from .sqlite_repository import SQLiteRepository
+
+
+def manual_company_start_pending(database):
+    """Check for work without consuming the startup lease or opening a workbook."""
+    request = _request_file(database.parent)
+    if request is not None:
+        return 'manual_retained' not in request and _has_event_provenance(request, request_field='request_id')
+    jobs = cli.job_database_path()
+    if (cli.storage_backend() != 'sqlite' or jobs != database.with_name('jobs.sqlite3')
+            or jobs.resolve(strict=True) != jobs):
+        raise ValueError('Manual Company selection requires the admitted local SQLite layout')
+    with closing(SQLiteRepository(jobs, os.environ.get('SPREADSHEET_ID', ''), readonly=True)) as repository:
+        return has_pending_eligible_company_event(repository)
+
+
+def run_manual_company_start(admission):
+    """Under inherited scraper admission, bridge and run only the exact event."""
+    database, jobs, _ = admission
+    root = database.parent
+    with cli.writer_lock(root / 'writer.lock'), ExitStack() as readers:
+        assert_release_settled(root)
+        local, _ = _open_readers(readers, database, jobs, root / 'inventories.sqlite3')
+        request = _request_file(root)
+        if request is None:
+            with closing(SQLiteRepository(jobs, local.spreadsheet_id)) as repository:
+                bridge = CompanyEventBridge(repository, root, state_database=database)
+                events = repository.pending_latest_company_events(BRIDGE_CONSUMER, limit=2)
+                if len(events) != 1 or events[0]['kind'] != 'company.eligible':
+                    return {'state': 'HELD_MANUAL_EVENT_NOT_UNIQUE'}
+                [observed] = bridge.observe_pending()['events']
+                if observed['state'] != 'PROPOSED_COMPANY_ONLY_SCRAPE':
+                    return {'state': 'HELD_MANUAL_EVENT_STALE'}
+                assert_normal_lifecycle_not_held(root, jobs)
+                [delivery] = bridge.process_pending(limit=1, writer_lock_held=True)
+                if delivery['state'] != 'REQUEST_WRITTEN' or delivery['event_id'] != events[0]['event_id']:
+                    return {'state': 'HELD_MANUAL_EVENT_BRIDGE', 'bridge': delivery}
+                _, request = read_verified_queued_event(repository, root)
+        else:
+            _, request = read_verified_queued_event(local, root)
+        request_digest = _json_digest(request)
+
+    result = execute_ordinary_event('admit-fetch', admission, request_sha256=request_digest)
+    if result['state'] != 'INVENTORY_FROZEN':
+        return result
+    scope = {'request_sha256': request_digest, 'cycle_id': result['cycle_id']}
+    return {**scope, **execute_ordinary_event('publish', admission, **scope)}
diff --git a/src/job_search_helper/operator_company_scope_hold.py b/src/job_search_helper/operator_company_scope_hold.py
new file mode 100644
--- /dev/null
+++ b/src/job_search_helper/operator_company_scope_hold.py
@@ -0,0 +1,169 @@
+"""Settle the explicit GA-ASI scope refusal before any provider is opened."""
+
+from contextlib import closing
+from hashlib import sha256
+import json
+import os
+import re
+
+from .cli import writer_lock
+from .company_events import canonical_company_fact, source_revision
+from .company_sources import repair_source
+from .engine import State
+from .inbox import InventoryInbox
+from .integration_release import assert_release_settled
+from .operator_company_request import _digest
+from .operator_selected_observation import _find_receipt
+from .outcomes import classify_outcome
+from .retained_work_runner import assert_normal_lifecycle_not_held
+from .scan_request import _cycle_views, _read_request, _unfinished_from_views
+from .sqlite_repository import SQLiteRepository
+from .temporary_retry import _sync_directory
+
+
+COMPANY = 'COMP-0072'
+PREFIX = 'operator-scope-hold:'
+POLICY = 'employer_scope_not_authorized'
+PARENT = ('BrassRing (shared parent board)', 'https://www.ga.com/careers/', '')
+
+
+def is_scope_hold_request(request):
+    request_id = request.get('request_id') if request is not None else None
+    return isinstance(request_id, str) and request_id.startswith(PREFIX)
+
+
+def _request(path, request_sha256):
+    if path.is_symlink() or not path.is_file():
+        raise ValueError('The exact scope-hold request is missing.')
+    raw = path.read_bytes()
+    request, companies = _read_request(path)
+    operator = request.get('operator_request')
+    if (request != json.loads(raw) or _digest(request) != request_sha256
+            or companies != [COMPANY] or operator is None or not is_scope_hold_request(request)
+            or request.get('start_last') != []):
+        raise ValueError('The queue does not contain the approved GA-ASI scope-hold request.')
+    return raw, request, operator
+
+
+def _facts(operator):
+    return {'request_id': operator['request_id'], 'company_id': COMPANY,
+            'source_revision': operator['source_revision'], 'provider': PARENT[0],
+            'source_current': True, 'inventory_status': 'not_fetched', 'storage_status': 'not_attempted',
+            'failure': {'category': 'uncertain_employer', 'provider_code': POLICY}}
+
+
+def _settled(repository, operator, binding, facts):
+    table = repository.db.execute(
+        "SELECT 1 FROM sqlite_master WHERE type='table' AND name='operator_company_scope_holds'"
+    ).fetchone()
+    if not table:
+        return None
+    row = repository.db.execute(
+        'SELECT proof, outcome_id FROM operator_company_scope_holds WHERE request_id=?',
+        (operator['request_id'],),
+    ).fetchone()
+    if row is None:
+        return None
+    proof = json.loads(row[0])
+    if any(proof.get(key) != value for key, value in binding.items()):
+        raise ValueError('The saved scope hold belongs to different request evidence.')
+    expected = classify_outcome(facts)
+    outcome = repository.db.execute('SELECT payload FROM scrape_outcomes WHERE outcome_id=?', (row[1],)).fetchone()
+    if (row[1] != expected['outcome_id'] or outcome is None or json.loads(outcome[0]) != {
+            key: expected[key] for key in ('outcome_id', 'identity', 'action', 'outcome', 'failure_fingerprint')}):
+        raise ValueError('The saved scope hold does not have its exact outcome.')
+    return proof, row[1]
+
+
+def _record(jobs, destination, state, runtime, root, operator, binding, facts):
+    from .runner import active_inbox_cycles
+
+    assert_normal_lifecycle_not_held(root, jobs)
+    with (closing(SQLiteRepository(jobs, destination)) as repository,
+          closing(InventoryInbox(root / 'inventories.sqlite3', destination, readonly=True)) as inbox,
+          repository.transaction()):
+        if (_unfinished_from_views(*_cycle_views(repository, state)) or active_inbox_cycles(inbox, state)
+                or any(cycle.get('start_request_id') == operator['request_id'] for cycle in state.cycles())):
+            raise ValueError('An existing scrape owns this application or request.')
+        matches = repository.matches('Companies', {'Company ID': COMPANY})
+        if len(matches) != 1:
+            raise ValueError('The scoped Company is missing or ambiguous.')
+        company = matches[0][1]
+        fact = canonical_company_fact(company)
+        if (not fact['eligible'] or source_revision(company) != operator['source_revision']
+                or fact['company_status'] != 'active'
+                or any(str(company.get(key) or '').strip() for key in ('Claimed By', 'Claim Token'))
+                or repair_source(company['ATS / Source'], company['Official Careers URL'],
+                                 COMPANY, company['Company']) != PARENT):
+            raise ValueError('Current GA-ASI evidence does not authorize the shared-board scope hold.')
+        repository.db.execute('''CREATE TABLE IF NOT EXISTS operator_company_scope_holds (
+            request_id TEXT PRIMARY KEY, request_sha256 TEXT NOT NULL UNIQUE,
+            proof TEXT NOT NULL, outcome_id TEXT NOT NULL REFERENCES scrape_outcomes(outcome_id))''')
+        if repository.db.execute('SELECT 1 FROM scrape_outcomes WHERE request_id=?',
+                                 (operator['request_id'],)).fetchone():
+            raise ValueError('The request already has an outcome without this scope-hold proof.')
+        outcome = repository._record_scrape_outcome_in_transaction(facts)
+        proof = {**binding, 'company': fact, 'runtime': runtime, 'resolved_source': list(PARENT)}
+        repository.db.execute('INSERT INTO operator_company_scope_holds VALUES (?,?,?,?)',
+                              (operator['request_id'], binding['request_sha256'], json.dumps(proof, sort_keys=True),
+                               outcome['outcome_id']))
+        return outcome['outcome_id']
+
+
+def _archive(queue, archived, raw):
+    archived.parent.mkdir(mode=0o700, exist_ok=True)
+    if not archived.exists() and not archived.is_symlink():
+        # Link without replacing any prior archive, sync it, then remove the
+        # queue name. An interruption between names leaves both replayable.
+        if queue.is_symlink() or queue.read_bytes() != raw:
+            raise ValueError('The scope-hold queue changed before archival.')
+        os.link(queue, archived, follow_symlinks=False)
+    if archived.is_symlink() or archived.read_bytes() != raw:
+        raise ValueError('The saved scope-hold request archive differs.')
+    _sync_directory(archived.parent)
+    _sync_directory(archived.parent.parent)
+    if _queue_matches(queue, raw):
+        queue.unlink()
+        _sync_directory(queue.parent)
+
+
+def _queue_matches(queue, raw):
+    return not queue.is_symlink() and queue.is_file() and queue.read_bytes() == raw
+
+
+def execute_scope_hold(admission, *, request_sha256):
+    """Under inherited scraper admission, settle and archive one exact request."""
+    if re.fullmatch(r'[0-9a-f]{64}', request_sha256 or '') is None:
+        raise ValueError('Supply one exact lowercase request SHA-256.')
+    database, jobs, runtime = admission
+    root = database.parent
+    queue = root / 'next-scan.json'
+    archives = root / 'operator-company-requests' / 'held'
+    archived = archives / (request_sha256 + '.json')
+    with writer_lock(root / 'writer.lock'), closing(State(str(database), readonly=True)) as state:
+        assert_release_settled(root)
+        if archives.resolve() != archives:
+            raise ValueError('The scope-hold archive must use the canonical request directory.')
+        is_archived = archived.exists() or archived.is_symlink()
+        raw, request, operator = _request(archived if is_archived else queue, request_sha256)
+        receipt = _find_receipt(root, request, request_sha256)
+        if receipt not in ({**operator, 'state': 'REQUEST_WRITTEN', 'request_sha256': request_sha256},
+                           {**operator, 'state': 'REQUEST_ALREADY_DURABLE', 'request_sha256': request_sha256}):
+            raise ValueError('The operator receipt does not bind this scope-hold request.')
+        binding = {'request_sha256': request_sha256, 'request_bytes_sha256': sha256(raw).hexdigest(),
+                   'reservation_sha256': _digest(receipt), 'policy': POLICY}
+        destination = InventoryInbox.destination_id(root / 'inventories.sqlite3')
+        facts = _facts(operator)
+        with closing(SQLiteRepository(jobs, destination, readonly=True)) as local:
+            prior = _settled(local, operator, binding, facts)
+        if prior is None:
+            if is_archived:
+                raise ValueError('The scope-hold archive has no matching committed result.')
+            outcome_id = _record(jobs, destination, state, runtime, root, operator, binding, facts)
+        else:
+            proof, outcome_id = prior
+            if proof['runtime'] != runtime and _queue_matches(queue, raw):
+                raise ValueError('Original runtime ownership is required to settle the saved request.')
+        _archive(queue, archived, raw)
+        return {'state': 'COMPANY_SCOPE_HELD', 'company_id': COMPANY, 'reason': POLICY,
+                'request_sha256': request_sha256, 'outcome_id': outcome_id}
