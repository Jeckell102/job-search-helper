+              patch.object(runner, 'PROJECT_ROOT', self.root),
+              patch.object(runner, '_load_environment'),
+              patch('job_search_helper.ats.fetch_inventory', side_effect=self.provider),
+              patch('job_search_helper.cli.get_remote_repository',
+                    side_effect=lambda *, write, **_: self.workbook(write)),
