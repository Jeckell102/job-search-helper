+from contextlib import closing
+import json
+import os
+from pathlib import Path
+from tempfile import TemporaryDirectory
+import unittest
+from unittest.mock import patch
+
+from job_search_helper import runner
+from job_search_helper.ats import Inventory
+from job_search_helper.engine import Engine, State
+from job_search_helper.inbox import InventoryInbox
+from job_search_helper.operator_company_request import queue_operator_company_request
+from job_search_helper.ordinary_company_event_command import guard_generic_ordinary_event
+from job_search_helper.positive_operator import execute_positive_operator
+from job_search_helper.repository import SCHEMAS, UncertainWriteError
+from job_search_helper.sheet_profile import COMPACT_PROFILE, COMPACT_SCHEMAS
+from job_search_helper.sqlite_repository import SQLiteRepository
+from test_exact_cycle_recovery import RecordingRemote
+import release_admission_bootstrap as bootstrap
+
+
+FESTO = 'COMP-0560'
+REQUEST = 'operator-company:festo-proof'
+URL = 'https://jobs.festo.com/viewalljobs/'
+RUNTIME = {
+    'state': 'COMPLETE', 'release_id': 'REL-' + '1' * 24,
+    'source_manifest_sha256': 'a' * 64, 'config_sha256': 'b' * 64,
+    'dependency_manifest_sha256': 'c' * 64,
+}
+
+
+class PositiveOperatorTests(unittest.TestCase):
+    def setUp(self):
+        directory = TemporaryDirectory()
+        self.addCleanup(directory.cleanup)
+        self.root = Path(directory.name)
+        self.database = self.root / 'state.db'
+        self.jobs = self.root / 'jobs.sqlite3'
+        self.inbox_path = self.root / 'inventories.sqlite3'
+        self.admission = self.database, self.jobs, RUNTIME
+        journal = self.root / 'integration-release-journal.json'
+        journal.write_text(json.dumps({
+            'schema': 'integration-release-journal-v1', 'state': 'COMPLETE',
+            'release_id': RUNTIME['release_id'],
+            'release': {'schema': 'integration-release-binding-v1',
+                        **{key: value for key, value in RUNTIME.items() if key != 'state'}},
+        }))
+        self.company = {
+            'Company ID': FESTO, 'Company': 'Festo', 'Company Status': 'Active',
+            'Official Careers URL': URL, 'ATS / Source': 'Official careers',
+            'Automatic Retry?': 'No', 'Scan State': 'Queued',
+        }
+        self.neighbor = {
+            'Company ID': 'COMP-OTHER', 'Company': 'Other', 'Company Status': 'Active',
+            'Official Careers URL': 'https://boards.greenhouse.io/other',
+            'ATS / Source': 'Greenhouse', 'Notes': 'original',
+        }
+        self.remote = RecordingRemote([self.company, self.neighbor], schemas=COMPACT_SCHEMAS)
+        self.remote_modes = []
+        self.fetches = []
+        with closing(State(self.database)), closing(InventoryInbox(self.inbox_path, 'fixture')):
+            pass
+        with self.local(initialize=True) as repo:
+            repo.ensure_columns('Opportunities', ['Opportunity ID'])
+            for tab in SCHEMAS:
+                rows = [self.company, self.neighbor] if tab == 'Companies' else []
+                repo.import_rows(tab, list(enumerate(rows, 2)))
+            repo.set_meta('ready', 'yes')
+            repo.set_meta('sheets_profile', COMPACT_PROFILE)
+            repo.commit([{'tab': 'Companies', 'identity': {'Company ID': 'COMP-OTHER'},
+                          'values': {'Notes': 'local only'}}])
+            queue_operator_company_request(repo, self.root, FESTO, REQUEST)
+            self.original_neighbor = repo.matches('Companies', {'Company ID': 'COMP-OTHER'})
+        self.original_remote_neighbor = self.remote.snapshot('Companies')[1]
+        env = patch.dict('os.environ', {
+            'SPREADSHEET_ID': 'fixture', 'JOB_STORAGE_BACKEND': 'sqlite',
+            'JOB_DB_FILE': str(self.jobs), 'STATE_DB_FILE': str(self.database),
+        })
+        env.start()
+        self.addCleanup(env.stop)
+
+    def local(self, **kwargs):
+        return closing(SQLiteRepository(self.jobs, 'fixture', **kwargs))
+
+    def workbook(self, write):
+        self.remote_modes.append(write)
+        return self.remote
+
+    def provider(self, ats_name, url, company_id, name):
+        self.fetches.append((ats_name, url, company_id, name))
+        posting = {
+            'posting_id': '12345', 'title': 'Technical Program Manager',
+            'url': 'https://jobs.festo.com/job/Fixture-Engineer/12345/',
+            'description': 'Design automation equipment, lead product development, and analyze prototypes.',
+            'company_id': company_id, 'company': name, 'ats': 'SuccessFactors',
+            'location': 'Mason, OH, United States', 'is_listed': True,
+        }
+        rejected = {**posting, 'posting_id': '12346', 'title': 'Receptionist',
+                    'url': 'https://jobs.festo.com/job/Fixture-Receptionist/12346/'}
+        return Inventory(
+            'complete', [posting, rejected],
+            source_url='https://jobs.festo.com/search/?q=&sortColumn=referencedate&sortDirection=desc',
+            ats='SuccessFactors',
+        )
+
+    def run_exact(self, action, cycle_id=None, request_id=REQUEST):
+        return execute_positive_operator(
+            action, self.admission, request_id=request_id, cycle_id=cycle_id,
+            fetcher=self.provider, remote_factory=self.workbook,
+        )
+
+    def test_reopen_same_request_recovers_lost_ack_without_refetch_or_replay(self):
+        with self.assertRaisesRegex(ValueError, 'operator Company'):
+            guard_generic_ordinary_event(self.database, fresh=True)
+        admitted = self.run_exact('admit-fetch')
+        self.assertEqual(admitted['state'], 'INVENTORY_FROZEN', admitted)
+        self.assertEqual(admitted['job_count'], 2)
+        cycle_id = admitted['cycle_id']
+        self.assertEqual(self.run_exact('admit-fetch'), admitted)
+        self.assertEqual(len(self.fetches), 1)
+        self.assertEqual(self.remote_modes, [False])
+        self.assertEqual(self.remote.commits, [])
+
+        actual_commit = self.remote.commit
+
+        def lost_ack(operations):
+            actual_commit(operations)
+            raise UncertainWriteError('fixture committed before losing the response')
+
+        with patch.object(self.remote, 'commit', side_effect=lost_ack):
+            pending = self.run_exact('publish', cycle_id)
+        self.assertEqual(pending['state'], 'PUBLICATION_HELD', pending)
+        self.assertEqual(len(self.remote.commits), 1, pending)
+        with closing(InventoryInbox(self.inbox_path, 'fixture')) as inbox:
+            plan = inbox.exact_remote_state(cycle_id, FESTO)
+            self.assertEqual(plan['state'], 'SYNC_PENDING')
+
+        with patch.object(self.remote, 'commit', side_effect=AssertionError('replayed write')):
+            confirmed = self.run_exact('publish', cycle_id)
+            self.assertEqual(confirmed['state'], 'SYNC_CONFIRMED', confirmed)
+            self.assertEqual(self.run_exact('publish', cycle_id), confirmed)
+        self.assertEqual(len(self.fetches), 1)
+        self.assertEqual(len(self.remote.commits), 1)
+        self.assertEqual(self.remote.snapshot('Companies')[1], self.original_remote_neighbor)
+        [published] = self.remote.snapshot('Job History')
+        self.assertEqual(published['Job Title'], 'Technical Program Manager')
+        self.assertEqual(self.remote.snapshot('Companies')[0]['ATS / Source'], 'Official careers')
+        with self.local(readonly=True) as repo:
+            self.assertEqual(repo.matches('Companies', {'Company ID': 'COMP-OTHER'}), self.original_neighbor)
+            self.assertEqual(len(repo.read('Job History')), 1)
+            self.assertEqual(repo.db.execute(
+                'SELECT request_id,company_id FROM scrape_outcomes'
+            ).fetchall(), [(REQUEST, FESTO)])
+        with closing(State(self.database, readonly=True)) as state:
+            cycle = state.cycle(cycle_id)
+            self.assertEqual(cycle['status'], 'Complete')
+            self.assertEqual(cycle['operator_request']['company_id'], FESTO)
+            self.assertNotIn('company_event', cycle)
+
+    def test_different_request_and_workbook_source_stop_before_provider(self):
+        with self.assertRaises(ValueError):
+            self.run_exact('admit-fetch', request_id='operator-company:other')
+        self.assertEqual(self.remote_modes, [])
+        self.remote.commit([{'tab': 'Companies', 'identity': {'Company ID': FESTO},
+                             'values': {'ATS / Source': 'Different source'}}])
+        with self.assertRaisesRegex(ValueError, 'controls_changed'):
+            self.run_exact('admit-fetch')
+        self.assertEqual(self.fetches, [])
+        self.assertTrue((self.root / 'next-scan.json').is_file())
+        with closing(State(self.database, readonly=True)) as state:
+            self.assertEqual(state.cycles(), [])
+
+    def test_admission_recovers_one_checkpoint_before_mirror_and_membership(self):
+        with patch.object(Engine, '_sync_cycle', side_effect=OSError('fixture admission interruption')):
+            with self.assertRaisesRegex(OSError, 'admission interruption'):
+                self.run_exact('admit-fetch')
+        self.assertEqual(self.fetches, [])
+        self.assertTrue((self.root / 'next-scan.json').is_file())
+        with closing(State(self.database, readonly=True)) as state:
+            [saved] = state.cycles()
+        result = self.run_exact('admit-fetch')
+        self.assertEqual(result['cycle_id'], saved['id'])
+        self.assertEqual(result['state'], 'INVENTORY_FROZEN')
+        self.assertEqual(len(self.fetches), 1)
+        self.assertFalse((self.root / 'next-scan.json').exists())
+        self.assertEqual(self.remote.commits, [])
