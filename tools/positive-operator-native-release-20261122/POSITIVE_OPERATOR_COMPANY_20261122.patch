+def has_positive_operator_scope(cycle, request_id=None):
+    operator = cycle.get('operator_request')
+    return any(isinstance(value, str) and value.startswith(POSITIVE_OPERATOR_PREFIX) for value in (
+        cycle.get('start_request_id'), operator.get('request_id') if isinstance(operator, dict) else None,
+        request_id,
+    ))
+
+
+def _operator_release(cycle):
+    from .repair_retry import RELEASE_BINDING_SCHEMA, canonical_release_binding
+    from .runner import _canonical_runtime_binding
+
+    runtime = _canonical_runtime_binding(cycle.get('runtime_binding'))
+    if runtime.pop('state') != 'COMPLETE':
+        raise ValueError('Positive operator publication requires a complete admitted release.')
+    return canonical_release_binding({'schema': RELEASE_BINDING_SCHEMA, **runtime})
+
+
+def positive_operator_receipt_binding(cycle, company_id):
+    from .repair_retry import release_binding_sha256
+    from .scan_request import _operator_request
+
+    companies = cycle.get('companies')
+    request_id = cycle.get('start_request_id')
+    if (cycle.get('all') is not False or not isinstance(companies, dict) or set(companies) != {company_id}
+            or not isinstance(request_id, str) or not POSITIVE_OPERATOR_REQUEST_ID.fullmatch(request_id)
+            or any(cycle.get(key) is not None for key in (
+                'company_event', 'repair_retry', 'temporary_retry', 'selected_retry_reservation_sha256',
+                'retained_work_exception', 'recovery_pause',
+            ))):
+        raise ValueError('Positive operator publication requires its sole admitted Company.')
+    item = companies[company_id]
+    fact = item.get('outcome_source_fact') if isinstance(item, dict) else None
+    if (not isinstance(fact, dict) or fact.get('company_id') != company_id or fact.get('eligible') is not True
+            or _digest(fact) != item.get('outcome_source_revision')):
+        raise ValueError('Positive operator publication requires its frozen Company source.')
+    source = item['outcome_source_revision']
+    operator = _operator_request({
+        'operator_request': cycle.get('operator_request'), 'request_id': request_id, 'source_revision': source,
+    }, [company_id])
+    if operator is None:
+        raise ValueError('Positive operator publication requires its stored operator request.')
+    release = _operator_release(cycle)
+    return {
+        'request_id': request_id, 'company_id': company_id, 'source_revision': source,
+        'release_id': release['release_id'], 'release_binding_sha256': release_binding_sha256(release),
+    }
+
+
+def positive_operator_admitted_request(cycle, company_id, state_directory):
+    from .operator_company_request import _digest as queue_digest
+    from .operator_selected_observation import _find_receipt
+    from .scan_request import _read_request, request_fingerprint
+
+    root = Path(state_directory)
+    request_path = root / 'last-scan-request.json'
+    if request_path.is_symlink() or not request_path.is_file():
+        raise ValueError('Positive operator queue evidence is missing.')
+    request, selected = _read_request(request_path)
+    digest = queue_digest(request)
+    receipt = _find_receipt(root, request, digest)
+    if (set(request) != {'request_id', 'company_ids', 'mode', 'source_revision', 'enqueued_at', 'start_last', 'operator_request'}
+            or request['start_last'] != [] or receipt.get('state') not in {'REQUEST_WRITTEN', 'REQUEST_ALREADY_DURABLE'}
+            or receipt != {**cycle['operator_request'], 'state': receipt['state'], 'request_sha256': digest}
+            or request.get('operator_request') != cycle['operator_request'] or selected != [company_id]
+            or request_fingerprint(request, selected) != cycle.get('request_fingerprint')):
+        raise ValueError('Positive operator queue evidence disagrees with its admission.')
+    return request
+
