+"""Run one operator-owned Company through existing exact storage/publication."""
+
+import argparse
+from contextlib import ExitStack
+from datetime import datetime, timezone
+import re
+
+from . import cli, publication_receipts
+from .company_events import canonical_company_fact, source_revision
+from .company_sources import repair_source
+from .engine import Engine
+from .exact_cycle_recovery import _recover_exact_cycle_locked
+from .exact_cycle_receipt import positive_operator_receipt_binding
+from .exact_cycle_sync import _company_guard
+from .integration_release import assert_active_release_binding
+from .operator_company_request import SCHEMA, _digest
+from .operator_selected_observation import _find_receipt
+from .ordinary_company_event_command import _open_engine, _open_readers, _request_file
+from .ordinary_company_event_fetch import _scope_has_storage, capture_scoped_provider
+from .retained_work_runner import assert_normal_lifecycle_not_held
+from .scan_request import _cycle_views, _unfinished_from_views, request_fingerprint, requested_scan
+from .scoped_provider_observation import provider_identity, read_observation
+from .sheet_profile import COMPACT_SCHEMAS
+
+
+PREFIX = 'operator-company:'
+REQUEST_ID = re.compile(r'operator-company:[A-Za-z0-9][A-Za-z0-9._-]{0,95}')
+CYCLE_ID = re.compile(r'CYC-[0-9A-F]{12}')
+DIRECTORY = 'positive-operator-inventory'
+
+
+def _request(root, request_id):
+    queued = _request_file(root)
+    request = queued if queued is not None and queued.get('request_id') == request_id else None
+    matching_queue = request is not None
+    if request is None:
+        last = root / 'last-scan-request.json'
+        if last.is_symlink() or not last.is_file():
+            raise ValueError('The selected operator request has no durable admission.')
+        from .scan_request import _read_request
+        request, _ = _read_request(last)
+    ids = request.get('company_ids')
+    revision = request.get('source_revision')
+    if (set(request) != {'mode', 'request_id', 'company_ids', 'source_revision',
+                         'enqueued_at', 'start_last', 'operator_request'}
+            or request['request_id'] != request_id or request['mode'] != 'company-only'
+            or not isinstance(ids, list) or len(ids) != 1
+            or not isinstance(ids[0], str) or not ids[0].strip()
+            or not isinstance(revision, str) or not re.fullmatch('[0-9a-f]{64}', revision)
+            or request['start_last'] != []):
+        raise ValueError('Expected one exact operator Company request.')
+    identity = {'schema': SCHEMA, 'request_id': request_id, 'company_id': ids[0],
+                'source_revision': revision}
+    from .scan_request import _enqueued_at
+    _enqueued_at(request)
+    digest = _digest(request)
+    receipt = _find_receipt(root, request, digest)
+    if (request['operator_request'] != identity
+            or receipt != {**identity, 'state': receipt.get('state'), 'request_sha256': digest}
+            or receipt['state'] not in {'REQUEST_WRITTEN', 'REQUEST_ALREADY_DURABLE'}):
+        raise ValueError('Operator request disagrees with its immutable receipt.')
+    return request, digest, matching_queue
+
+
+def _current_company(local, request, cycle=None):
+    company_id = request['company_ids'][0]
+    matches = local.matches('Companies', {'Company ID': company_id})
+    row = matches[0][1] if len(matches) == 1 else {}
+    if (not row.get('Company') or not canonical_company_fact(row)['eligible']
+            or source_revision(row) != request['source_revision']
+            or any(str(row.get(key) or '').strip() for key in ('Claimed By', 'Claim Token'))
+            or row.get('Scan State') == 'Blocked / Manual Review'
+            or (cycle is not None and (row.get('Active Cycle ID') != cycle['id']
+                                        or row['Company'] != cycle['companies'][company_id]['company']))):
+        raise ValueError('The selected Company source or controls changed.')
+    return row
+
+
+def _cycle(local, state, request, runtime, cycle_id=None, *, pending=False):
+    request_id = request['request_id']
+    company_id = request['company_ids'][0]
+    local_cycles, mirrors = _cycle_views(local, state)
+    cycles = [row for row in local_cycles if row.get('start_request_id') == request_id]
+    from .scan_request import cycle_metadata
+    reflected = [
+        (row, cycle_metadata(row)) for row in mirrors
+        if (row.get('Cycle ID') in {c['id'] for c in cycles}
+            or cycle_metadata(row).get('start_request_id') == request_id)
+    ]
+    blockers = _unfinished_from_views(local_cycles, mirrors)
+    if not cycles and not reflected and not blockers and cycle_id is None:
+        return None
+    if len(cycles) != 1 or len(reflected) > 1 or (not pending and len(reflected) != 1):
+        raise ValueError('The operator request is held behind unfinished or unverified work.')
+    cycle = cycles[0]
+    item = cycle.get('companies', {}).get(company_id, {})
+    if (not CYCLE_ID.fullmatch(cycle.get('id', ''))
+            or (cycle_id is not None and cycle['id'] != cycle_id)
+            or cycle['status'] not in {'In Progress', 'Complete'}
+            or (pending and (cycle['status'] != 'In Progress' or item.get('stage') != 'queued'))
+            or blockers - {cycle['id']}
+            or set(cycle['companies']) != {company_id} or cycle.get('all') is not False
+            or cycle.get('request_fingerprint') != request_fingerprint(request, [company_id])
+            or cycle.get('operator_request') != request['operator_request']
+            or item.get('outcome_source_fact', {}).get('company_id') != company_id
+            or item.get('outcome_source_revision') != request['source_revision']):
+        raise ValueError('Saved operator cycle does not own this exact request.')
+    if reflected:
+        mirror, notes = reflected[0]
+        # The local mirror can lead State only at the final, receipt-backed settlement.
+        if (mirror['Cycle ID'] != cycle['id'] or notes.get('company_ids') != [company_id]
+                or notes.get('all') is not False
+                or (pending and mirror.get('Cycle Status') != 'In Progress')
+                or any(notes.get(key) != cycle.get(key) for key in (
+                    'start_request_id', 'operator_request', 'request_fingerprint', 'runtime_binding',
+                ))):
+            raise ValueError('Saved operator cycle mirror differs from its exact request.')
+    Engine.validate_cycle_runtime_binding(cycle, runtime)
+    return cycle
+
+
+def _observation_binding(cycle, request, digest):
+    cid = request['company_ids'][0]
+    item = cycle['companies'][cid]
+    return {'schema': 'positive-operator-inventory-v1', 'cycle_id': cycle['id'], 'company_id': cid,
+            'request': request, 'request_sha256': digest,
+            'request_fingerprint': cycle['request_fingerprint'], 'runtime': cycle['runtime_binding'],
+            'company_name': item['company'], 'source_fact': item['outcome_source_fact']}
+
+
+def _finish(engine, cycle, company, payload, binding):
+    from .exact_cycle_planner import _digest as plan_digest
+    from .inbox import InventoryInbox
+    from .scrape_outcome_producer import normal_cycle_outcome_facts
+
+    cid = binding['company_id']
+    item = cycle['companies'][cid]
+    if item.get('stage') != 'complete' or item.get('inventory_status') != 'complete':
+        return None
+    receipt = publication_receipts.receipt(engine.inbox.connection, binding)
+    if receipt is None or receipt['state'] != publication_receipts.SYNC_CONFIRMED:
+        raise ValueError('Operator completion requires its exact workbook confirmation.')
+    parents = engine.repo.db.execute(
+        'SELECT apply_id,plan_digest,inventory_payload_digest FROM exact_local_applications '
+        'WHERE cycle=? AND company=?', (cycle['id'], cid),
+    ).fetchall()
+    if len(parents) != 1 or parents[0][2] != plan_digest(payload):
+        raise ValueError('Operator completion requires the matching applied inventory.')
+    InventoryInbox._verify_exact_local_acknowledgement(
+        engine.inbox.connection, engine.repo, cycle['id'], cid, parents[0][1],
+        receipt['receipt_id'], receipt['acknowledgement_id'], expected_apply_id=parents[0][0],
+    )
+    facts = normal_cycle_outcome_facts(cycle, company, item, storage_confirmed=True)
+    outcome = engine.repo.record_scrape_outcome(facts)['outcome']
+    if cycle['status'] != 'Complete':
+        engine._sync_cycle(cycle)
+    return {'state': 'SYNC_CONFIRMED', 'cycle_id': cycle['id'], 'company_id': cid,
+            'receipt_id': receipt['receipt_id'], 'outcome_id': outcome['outcome_id']}
+
+
+def execute_positive_operator(action, admission, *, request_id, cycle_id=None,
+                              fetcher=None, remote_factory=None):
+    """Execute one exact action while the bootstrap holds scraper admission."""
+    if (action not in {'admit-fetch', 'publish'} or not REQUEST_ID.fullmatch(request_id)
+            or (cycle_id is not None and not CYCLE_ID.fullmatch(cycle_id))
+            or (action == 'publish' and cycle_id is None)):
+        raise ValueError('Expected one named operator request and exact action.')
+    database, jobs, runtime = admission
+    if runtime['state'] != 'COMPLETE':
+        raise ValueError('Operator publication requires an installed release.')
+    if fetcher is None:
+        from .ats import fetch_inventory
+        fetcher = fetch_inventory
+    if remote_factory is None:
+        def remote_factory(write):
+            return cli.get_remote_repository(
+                write=write, interactive=False, schemas=COMPACT_SCHEMAS, evidence_archives=False,
+            )
+
+    root = database.parent
+    inbox_path = root / 'inventories.sqlite3'
+
+    def workbook(write):
+        remote = remote_factory(write)
+        if remote.spreadsheet_id != local.spreadsheet_id or remote.schemas != COMPACT_SCHEMAS:
+            raise ValueError('Operator execution requires the configured compact workbook.')
+        remote.validate_schema()
+        return remote
+
+    with cli.writer_lock(root / 'writer.lock'), ExitStack() as stack:
+        assert_active_release_binding(root, {
+            'schema': 'integration-release-binding-v1',
+            **{key: value for key, value in runtime.items() if key != 'state'},
+        })
+        local, state = _open_readers(stack, database, jobs, inbox_path)
+        request, digest, queued = _request(root, request_id)
+        cid = request['company_ids'][0]
+        cycle = _cycle(local, state, request, runtime, cycle_id, pending=queued)
+        assert_normal_lifecycle_not_held(root, jobs)
+        company = _current_company(local, request, None if queued else cycle)
+        if queued:
+            if action != 'admit-fetch':
+                raise ValueError('Admit the exact request before publication.')
+            _company_guard(local, workbook(False), cid, company['Official Careers URL'],
+                           additional_fields=('Company', 'ATS / Source'))
+            if _request(root, request_id) != (request, digest, True):
+                raise ValueError('The selected operator request changed during admission.')
+            engine = _open_engine(stack, database, jobs, local.spreadsheet_id, runtime)
+            if cycle is not None:
+                item = cycle['companies'][cid]
+                observation = root / DIRECTORY / (cycle['id'] + '.json')
+                if (item.get('company') != company['Company']
+                        or item.get('outcome_source_fact') != canonical_company_fact(company)
+                        or observation.exists() or observation.is_symlink()
+                        or _scope_has_storage(local, root, cycle['id'])):
+                    raise ValueError('Interrupted operator admission has competing work.')
+                # requested_scan restores its mirror before consuming the queue.
+                # Restore the sole Company membership if start_cycle stopped
+                # after saving State and before applying that membership.
+                if (company.get('Active Cycle ID') != cycle['id']
+                        or company.get('Scan State') != 'Queued'):
+                    engine.repo.commit([{
+                        'tab': 'Companies', 'identity': {'Company ID': cid},
+                        'expected': {
+                            field: company.get(field, '') for field in (
+                                'Company', 'Company Status', 'ATS / Source', 'Official Careers URL',
+                                'Scan State', 'Active Cycle ID', 'Claimed By', 'Claim Token',
+                            )
+                        },
+                        'values': {'Active Cycle ID': cycle['id'], 'Scan State': 'Queued'},
+                        'append_if_missing': False,
+                    }])
+            selected = requested_scan(engine, engine.state, database)
+            if not selected or (cycle is not None and selected != cycle['id']):
+                raise ValueError('Operator request admission returned a different cycle.')
+            cycle = _cycle(local, state, request, runtime, selected)
+            company = _current_company(local, request, cycle)
+        if cycle is None:
+            raise ValueError('No cycle owns the exact operator request.')
+
+        binding = _observation_binding(cycle, request, digest)
+        company_url = company['Official Careers URL']
+        ats, board, _ = repair_source(company.get('ATS / Source', ''), company_url, cid, company['Company'])
+        provider = provider_identity(ats, board)
+        if not provider:
+            raise ValueError('The operator Company provider is unverified.')
+        path = root / DIRECTORY / (cycle['id'] + '.json')
+        record = read_observation(path, binding)
+        result = {'cycle_id': cycle['id'], 'company_id': cid, 'request_sha256': digest}
+        if action == 'admit-fetch':
+            if record is None:
+                if (cycle['status'] != 'In Progress' or cycle['companies'][cid]['stage'] != 'queued'
+                        or _scope_has_storage(local, root, cycle['id'])):
+                    raise ValueError('The operator cycle already contains saved work.')
+                if not queued:
+                    _company_guard(local, workbook(False), cid, company_url,
+                                   additional_fields=('Company', 'ATS / Source'))
+                if _current_company(local, request, cycle) != company:
+                    raise ValueError('The operator Company changed before provider access.')
+                record = capture_scoped_provider(
+                    path, binding, company, provider, fetcher, lambda: datetime.now(timezone.utc),
+                )
+                _current_company(local, request, cycle)
+            if record['state'] != 'FROZEN':
+                return {'state': 'HELD_FETCH_UNCERTAIN', **result}
+            return {'state': 'INVENTORY_FROZEN', **result, 'inventory_sha256': record['inventory_sha256'],
+                    'inventory_status': record['inventory']['status'], 'job_count': len(record['inventory']['jobs'])}
+
+        if record is None or record['state'] != 'FROZEN':
+            return {'state': 'HELD_NO_FROZEN_INVENTORY', **result}
+        inventory = record['inventory']
+        if (inventory['status'] != 'complete' or not inventory['jobs']
+                or inventory['browser_pending_urls'] or inventory['browser_discovery_incomplete']
+                or inventory.get('verified_zero') is not None or inventory['outcome_failure'] is not None
+                or inventory['requested_url'] != company_url
+                or provider_identity(inventory['ats'], inventory['source_url']) != provider):
+            return {'state': 'HELD_NONPOSITIVE_INVENTORY', **result}
+        payload = {key: value for key, value in inventory.items()
+                   if key not in {'status', 'verified_zero', 'outcome_failure'}}
+        payload['inventory_status'] = 'complete'
+        publication = positive_operator_receipt_binding(cycle, cid)
+        engine = _open_engine(stack, database, jobs, local.spreadsheet_id, runtime, publication=True)
+        saved = engine.inbox.get(cycle['id'], cid)
+        if saved is None and cycle['companies'][cid]['stage'] == 'complete':
+            return _finish(engine, cycle, company, payload, publication)
+        remote = workbook(True)
+
+        def guard(company_id, url):
+            if company_id != cid or url != company_url:
+                raise ValueError('The operator publication requested a foreign Company or URL.')
+            _current_company(local, request, cycle)
+            if read_observation(path, binding) != record:
+                raise ValueError('The frozen operator inventory changed.')
+            return _company_guard(local, remote, cid, url,
+                                  additional_fields=('Company', 'ATS / Source'))
+
+        if saved is None:
+            guard(cid, company_url)
+            if (cycle['companies'][cid]['stage'] != 'queued'
+                    or engine.inbox.plan(cycle['id'], cid) is not None):
+                raise ValueError('The saved operator inventory disappeared after planning.')
+            engine.inbox.save(cycle['id'], cid, payload)
+        if engine.inbox.get(cycle['id'], cid) != (payload, False):
+            raise ValueError('The operator Inbox contains a conflicting inventory.')
+
+        report = _recover_exact_cycle_locked(
+            engine, remote, cycle['id'], [cid], positive_operator_guard=guard,
+        )
+        if report['held'] or report['skipped'] or report['confirmed'] != [cid]:
+            return {'state': 'PUBLICATION_HELD', **report}
+        return _finish(engine, engine.state.cycle(cycle['id']),
+                       _current_company(local, request, cycle), payload, publication)
+
+
+def positive_operator_command(argv, admission):
+    parser = argparse.ArgumentParser(prog='./job-search-scraper operator-company', allow_abbrev=False)
+    parser.add_argument('action', choices=('admit-fetch', 'publish'))
+    parser.add_argument('--request-id', required=True)
+    parser.add_argument('--cycle-id')
+    args = parser.parse_args(argv)
+    return execute_positive_operator(
+        args.action, admission, request_id=args.request_id, cycle_id=args.cycle_id,
+    )
