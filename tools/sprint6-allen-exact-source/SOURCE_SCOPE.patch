--- /dev/null
+++ b/src/job_search_helper/allen_source_reconciliation.py
@@ -0,0 +1,213 @@
+"""One exact external-first Allen source correction using supplied clients.
+
+The caller owns normal scraper/writer leases and runtime approval. This module
+creates no clients, services, requests, cycles, or provider/model work.
+"""
+import copy
+import hashlib
+import json
+
+from .company_events import canonical_company_fact, source_revision
+from .repository import RepositoryError, ReviewFieldsChangedError, UncertainWriteError
+from .sheets_sync import SheetsSynchronizer
+from .sqlite_repository import encode
+
+
+COMPANY_ID = 'COMP-0164'
+COMPANY_NAME = 'Allen Control Systems'
+BEFORE = {'ATS / Source': 'Greenhouse',
+          'Official Careers URL': 'https://job-boards.greenhouse.io/allencontrolsystems'}
+AFTER = {'ATS / Source': 'Ashby',
+         'Official Careers URL': 'https://jobs.ashbyhq.com/allen-control-systems'}
+SOURCE_FIELDS = frozenset(AFTER)
+CONTROL_FIELDS = ('Company ID', 'Company', 'Company Status')
+RECORD_KEY = 'allen_source_reconciliation:COMP-0164'
+ORIGIN = 'allen-source-reconciliation'
+
+
+def _intent(value, local, remote):
+    fields = {'schema', 'spreadsheet_id', 'company_id', 'company', 'company_status',
+              'before', 'after', 'expected_source_revision'}
+    if (not isinstance(value, dict) or set(value) != fields
+            or value['schema'] != 'allen-source-reconciliation-v1'
+            or value['company_id'] != COMPANY_ID or value['company'] != COMPANY_NAME
+            or value['before'] != BEFORE or value['after'] != AFTER
+            or not isinstance(value['company_status'], str)
+            or value['company_status'].strip().casefold() != 'active'
+            or not isinstance(value['spreadsheet_id'], str) or not value['spreadsheet_id']
+            or value['spreadsheet_id'] != local.spreadsheet_id
+            or value['spreadsheet_id'] != remote.spreadsheet_id):
+        raise RepositoryError('Allen source correction requires the exact approved intent and workbook.')
+    before = {'Company ID': COMPANY_ID, 'Company': COMPANY_NAME,
+              'Company Status': value['company_status'], **BEFORE}
+    if source_revision(before) != value['expected_source_revision']:
+        raise RepositoryError('Allen source correction before revision differs from its source intent.')
+    return copy.deepcopy(value), hashlib.sha256(encode(value).encode('utf-8')).hexdigest()
+
+
+def _record(local, intent, digest):
+    raw = local.get_meta(RECORD_KEY)
+    if raw is None:
+        return None
+    try:
+        record = json.loads(raw)
+    except (TypeError, ValueError) as exc:
+        raise RepositoryError('Allen source correction record is unreadable.') from exc
+    if (not isinstance(record, dict) or record.get('intent') != intent
+            or record.get('intent_sha256') != digest
+            or record.get('state') not in {'WRITE_CLAIMED', 'REMOTE_CONFIRMED', 'COMPLETE'}):
+        raise RepositoryError('Allen source correction has a conflicting durable owner.')
+    return record
+
+
+def _local(local, intent):
+    if local.get_meta('company_event_external_baseline') != 'yes':
+        raise RepositoryError('Allen reconciliation requires Jobs with its external baseline.')
+    rows = local.matches('Companies', {'Company ID': COMPANY_ID})
+    if len(rows) != 1:
+        raise RepositoryError('Allen reconciliation requires one existing local Company.')
+    rid, row = rows[0]
+    if (row.get('Company') != COMPANY_NAME
+            or row.get('Company Status') != intent['company_status']
+            or any(str(row.get(field) or '').strip() for field in ('Claimed By', 'Claim Token'))):
+        raise RepositoryError('Allen reconciliation local Company controls changed.')
+    source = {field: row.get(field, '') for field in SOURCE_FIELDS}
+    if source not in (BEFORE, AFTER):
+        raise RepositoryError('Allen reconciliation local source is outside the exact transition.')
+    baseline = local.baseline('Companies', rid)
+    if not baseline or any(baseline.get(field, '') != row.get(field, '')
+                           for field in SOURCE_FIELDS | set(CONTROL_FIELDS)):
+        raise RepositoryError('Allen reconciliation source or identity has an unsynchronized baseline.')
+    dirty = {item[0] for item in local.db.execute(
+        "SELECT header FROM dirty WHERE tab='Companies' AND row_id=?", (rid,))}
+    conflicts = {item[0] for item in local.db.execute(
+        "SELECT header FROM conflicts WHERE tab='Companies' AND row_id=?", (rid,))}
+    if dirty & (SOURCE_FIELDS | set(CONTROL_FIELDS)) or conflicts & (
+            SOURCE_FIELDS | set(CONTROL_FIELDS) | {'__missing__'}):
+        raise RepositoryError('Allen reconciliation source or identity has a pending change.')
+    delivery = local.db.execute(
+        "SELECT data FROM delivery_attempts WHERE tab='Companies' AND row_id=?", (rid,)).fetchone()
+    if delivery and SOURCE_FIELDS & set(json.loads(delivery[0])):
+        raise RepositoryError('Allen reconciliation has an unresolved source delivery.')
+    return rid, row, 'BEFORE' if source == BEFORE else 'AFTER'
+
+
+def _remote(remote, intent):
+    matches = [(number, row) for number, row in remote.read_columns('Companies', ['Company ID'])
+               if str(row.get('Company ID', '')).strip() == COMPANY_ID]
+    if len(matches) != 1:
+        raise RepositoryError('Allen reconciliation requires one exact remote Company.')
+    number = matches[0][0]
+    row = remote.read_row('Companies', number)
+    if (row.get('Company ID') != COMPANY_ID or row.get('Company') != COMPANY_NAME
+            or row.get('Company Status') != intent['company_status']
+            or any(str(row.get(field) or '').strip() for field in ('Claimed By', 'Claim Token'))):
+        raise RepositoryError('Allen reconciliation remote Company controls changed.')
+    source = {field: row.get(field, '') for field in SOURCE_FIELDS}
+    if source not in (BEFORE, AFTER):
+        raise ReviewFieldsChangedError('Companies', {'Company ID': COMPANY_ID})
+    return number, row, 'BEFORE' if source == BEFORE else 'AFTER'
+
+
+def _inspect(local, remote, intent):
+    intent, digest = _intent(intent, local, remote)
+    sync = SheetsSynchronizer(local, remote)
+    sync._refuse_retained_publication_hold()
+    _rid, row, local_phase = _local(local, intent)
+    record = _record(local, intent, digest)
+    number, observed, remote_phase = _remote(remote, intent)
+    if local_phase == 'AFTER' and remote_phase != 'AFTER':
+        raise RepositoryError('Allen local source cannot precede confirmed external source.')
+    if record and record['state'] in {'REMOTE_CONFIRMED', 'COMPLETE'} and remote_phase != 'AFTER':
+        raise RepositoryError('Allen confirmed remote source changed.')
+    if record and record['state'] == 'COMPLETE' and local_phase != 'AFTER':
+        raise RepositoryError('Allen completed local source changed.')
+    if record and record['state'] == 'COMPLETE' and record.get('company_event') != _current_event(local, row):
+        raise RepositoryError('Allen completed source event changed.')
+    return intent, digest, sync, record, number, observed, remote_phase, row
+
+
+def preflight_allen_source_reconciliation(local, remote, intent):
+    """Read the exact intent/Company/record; never write local or remote state."""
+    _intent_value, digest, _sync, record, _number, _observed, phase, _row = _inspect(
+        local, remote, intent)
+    held = bool(record and record['state'] == 'WRITE_CLAIMED' and phase == 'BEFORE')
+    return {'state': 'HELD_UNCERTAIN_WRITE' if held else 'READY',
+            'intent_sha256': digest, 'remote_phase': phase,
+            'would_write_remote': phase == 'BEFORE' and record is None}
+
+
+def _save(local, intent, digest, state, *, event=None):
+    with local.transaction():
+        _local(local, intent)
+        previous = _record(local, intent, digest)
+        if state == 'WRITE_CLAIMED' and previous is not None:
+            raise RepositoryError('Allen remote write was already claimed.')
+        if previous and previous['state'] == 'COMPLETE' and state != 'COMPLETE':
+            return previous
+        record = {'intent': intent, 'intent_sha256': digest, 'state': state}
+        if event is not None:
+            record['company_event'] = event
+        local.set_meta(RECORD_KEY, encode(record))
+    return record
+
+
+def _current_event(local, current):
+    expected = source_revision(current)
+    rows = local.db.execute(
+        'SELECT o.payload FROM company_revisions r JOIN company_event_outbox o '
+        'ON o.company_id=r.company_id AND o.revision=r.revision '
+        'WHERE r.company_id=? AND r.revision=(SELECT MAX(revision) FROM company_revisions '
+        'WHERE company_id=?) AND r.source_revision=?', (COMPANY_ID, COMPANY_ID, expected)).fetchall()
+    if len(rows) != 1:
+        raise RepositoryError('Allen source reconciliation has no unique current event.')
+    event = json.loads(rows[0][0])
+    if event.get('fact') != canonical_company_fact(current) or event.get('source_revision') != expected:
+        raise RepositoryError('Allen source reconciliation event differs from current source.')
+    return event
+
+
+def continue_allen_source_reconciliation(local, remote, intent):
+    """Confirm two remote source cells, merge only those fields, emit one event.
+
+    A claimed write is never retried. Only exact remote AFTER readback can
+    advance that claim, including after an uncertain commit or a restart.
+    """
+    if local.readonly:
+        raise RepositoryError('Allen source continuation requires writable Jobs.')
+    intent, digest, sync, record, number, observed, phase, _row = _inspect(local, remote, intent)
+    wrote = False
+    if phase == 'BEFORE':
+        if record is not None:
+            raise UncertainWriteError('Allen source write is claimed; exact after readback is required.')
+        _save(local, intent, digest, 'WRITE_CLAIMED')
+        operation = {'tab': 'Companies', 'identity': {'Company ID': COMPANY_ID},
+                     'expected': {**{field: observed[field] for field in CONTROL_FIELDS},
+                                  **{field: observed[field] for field in ('Claimed By', 'Claim Token')
+                                     if field in observed}, **BEFORE},
+                     'values': dict(AFTER), 'append_if_missing': False}
+        try:
+            remote.commit([operation])
+        except UncertainWriteError:
+            # The readback below is the only permitted resolution, never a second commit.
+            pass
+        wrote = True
+        number, observed, phase = _remote(remote, intent)
+        if phase != 'AFTER':
+            raise UncertainWriteError('Allen source write remains unconfirmed; no replay is permitted.')
+    _save(local, intent, digest, 'REMOTE_CONFIRMED')
+    _local(local, intent)
+    sync.merge_remote('Companies', [(number, {'Company ID': COMPANY_ID, **AFTER})],
+                      complete_snapshot=False)
+    _rid, current, local_phase = _local(local, intent)
+    if local_phase != 'AFTER':
+        raise RepositoryError('Allen source merge did not confirm the exact transition.')
+    expected = source_revision(current)
+    local.reconcile_external_company_events(company_id=COMPANY_ID,
+                                            expected_source_revision=expected, origin=ORIGIN)
+    event = _current_event(local, current)
+    if record and record['state'] == 'COMPLETE' and record.get('company_event') != event:
+        raise RepositoryError('Allen completed source event changed.')
+    _save(local, intent, digest, 'COMPLETE', event=event)
+    return {'state': 'COMPLETE', 'intent_sha256': digest,
+            'company_event': event, 'remote_write_attempted': wrote}
