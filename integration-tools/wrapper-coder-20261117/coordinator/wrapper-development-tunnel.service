[Unit]
Description=Jetson inference and MuleLab wrapper development connection
After=network-online.target wrapper-development-host.service
Wants=wrapper-development-host.service
[Service]
ExecStart=/usr/bin/ssh -NT -o BatchMode=yes -o StrictHostKeyChecking=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o ConnectTimeout=10 -R 127.0.0.1:18789:127.0.0.1:18789 -L 127.0.0.1:18790:192.168.1.222:8787 jetson
Restart=always
RestartSec=5
[Install]
WantedBy=default.target
